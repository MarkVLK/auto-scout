# Example unit only. `./auto-scout deploy companion` renders a role-specific
# service with the configured username, workspace path, and storage root.
[Unit]
Description=Auto-Scout companion runtime
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/auto-scout
Environment=AUTO_SCOUT_ROS_MASTER_URI=http://scout-host-or-ip:11311
Environment=AUTO_SCOUT_ROS_HOSTNAME=companion-host-or-ip
ExecStart=/bin/bash -lc '/opt/auto-scout/scripts/start_companion_stack.sh up'
ExecStop=/bin/bash -lc '/opt/auto-scout/scripts/start_companion_stack.sh down'
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
