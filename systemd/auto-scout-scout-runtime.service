# Example unit only. `./auto-scout deploy scout` renders a role-specific
# service with the configured username, workspace path, and device settings.
[Unit]
Description=Auto-Scout scout runtime
After=network.target
Wants=network.target

[Service]
Type=simple
User=linaro
Group=linaro
WorkingDirectory=/userdata/catkin_ws/src/auto-scout
Environment=AUTO_SCOUT_CONFIG=/userdata/catkin_ws/src/auto-scout/config/scout_config.yaml
Environment=AUTO_SCOUT_SITE_CONFIG=/userdata/catkin_ws/src/auto-scout/config/site.yaml
Environment=ROS_MASTER_URI=http://scout-host-or-ip:11311
Environment=ROS_HOSTNAME=scout-host-or-ip
ExecStart=/bin/bash -lc '/userdata/catkin_ws/src/auto-scout/scripts/start_scout_runtime.sh'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
