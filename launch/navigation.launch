<?xml version="1.0"?>
<launch>
  <!--
    Companion-side navigation stack.

    Assumptions:
    - /scan is already being published by a Scout bridge or LiDAR driver
    - /odom or an equivalent pose source is already available
    - this launch runs on the companion host, not on the stock Scout alone
  -->

  <arg name="map_file" default="/srv/auto-scout/maps/house_map.yaml"/>
  <arg name="autonomy_cmd_vel" default="/scout/cmd_vel_companion"/>
  <arg name="planner_cmd_vel" default="/scout/cmd_vel_planner"/>
  <arg name="odom_model_type" default="$(optenv AUTO_SCOUT_ODOM_MODEL_TYPE diff)"/>

  <param name="robot_description" textfile="$(find auto-scout)/urdf/scout.urdf" />

  <!-- Publish fixed Scout frame transforms needed by AMCL, costmaps, and laser processing. -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <param name="publish_frequency" value="30.0"/>
  </node>

  <node name="map_file_guard" pkg="auto-scout" type="map_file_guard.py" output="screen" required="true">
    <param name="map_file" value="$(arg map_file)"/>
  </node>

  <!-- Load a previously saved occupancy grid -->
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)"/>

  <!-- Localization -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="min_particles" value="100"/>
    <param name="max_particles" value="3000"/>
    <param name="kld_err" value="0.01"/>
    <param name="kld_z" value="0.99"/>
    <param name="update_min_d" value="0.1"/>
    <param name="update_min_a" value="0.1"/>
    <param name="resample_interval" value="2"/>
    <param name="transform_tolerance" value="0.5"/>
    <param name="recovery_alpha_slow" value="0.001"/>
    <param name="recovery_alpha_fast" value="0.1"/>
    <param name="gui_publish_rate" value="10.0"/>

    <param name="laser_max_beams" value="60"/>
    <param name="laser_max_range" value="12.0"/>
    <param name="laser_z_hit" value="0.95"/>
    <param name="laser_z_short" value="0.1"/>
    <param name="laser_z_max" value="0.05"/>
    <param name="laser_z_rand" value="0.05"/>
    <param name="laser_sigma_hit" value="0.2"/>
    <param name="laser_lambda_short" value="0.1"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>
    <param name="laser_model_type" value="likelihood_field"/>

    <param name="odom_model_type" value="$(arg odom_model_type)"/>
    <param name="odom_alpha1" value="0.2"/>
    <param name="odom_alpha2" value="0.2"/>
    <param name="odom_alpha3" value="0.2"/>
    <param name="odom_alpha4" value="0.2"/>
    <param name="odom_alpha5" value="0.2"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="global_frame_id" value="map"/>
  </node>

  <!-- Path planning -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <remap from="cmd_vel" to="$(arg planner_cmd_vel)"/>
    <rosparam file="$(find auto-scout)/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find auto-scout)/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find auto-scout)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find auto-scout)/config/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find auto-scout)/config/base_local_planner_params.yaml" command="load"/>
    <rosparam file="$(find auto-scout)/config/global_planner_params.yaml" command="load"/>

    <param name="recovery_behavior_enabled" value="true"/>
    <param name="clearing_rotation_allowed" value="true"/>
  </node>
</launch>
